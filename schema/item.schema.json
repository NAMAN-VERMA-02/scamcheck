{
  "$defs": {
    "Adversarial": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "prompt_injection",
            "zero_width",
            "homoglyph",
            "transliteration",
            "llm_rewrite"
          ],
          "title": "Type",
          "type": "string"
        },
        "parent_id": {
          "pattern": "^[a-z]{2,4}-[0-9]{3,6}$",
          "title": "Parent Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "parent_id"
      ],
      "title": "Adversarial",
      "type": "object"
    },
    "Annotation": {
      "additionalProperties": false,
      "properties": {
        "annotator": {
          "title": "Annotator",
          "type": "string"
        },
        "label": {
          "enum": [
            "scam",
            "legitimate",
            "promotional",
            "ambiguous"
          ],
          "title": "Label",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "confidence": {
          "maximum": 3,
          "minimum": 1,
          "title": "Confidence",
          "type": "integer"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Evidence",
          "type": "array"
        },
        "guideline_version": {
          "title": "Guideline Version",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        }
      },
      "required": [
        "annotator",
        "label",
        "confidence",
        "guideline_version"
      ],
      "title": "Annotation",
      "type": "object"
    },
    "Gold": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "scam",
            "legitimate",
            "promotional",
            "ambiguous"
          ],
          "title": "Label",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "basis": {
          "enum": [
            "donor_confirmed",
            "official_advisory",
            "sender_verified",
            "annotator_judgment"
          ],
          "title": "Basis",
          "type": "string"
        },
        "adjudicated": {
          "default": false,
          "title": "Adjudicated",
          "type": "boolean"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "label",
        "basis"
      ],
      "title": "Gold",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "enum": [
            "donated",
            "public_dataset",
            "official_advisory",
            "synthetic"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "licence_verified": {
          "default": false,
          "title": "Licence Verified",
          "type": "boolean"
        },
        "consent_id": {
          "anyOf": [
            {
              "pattern": "^c-[0-9]{4,6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consent Id"
        },
        "collected_at": {
          "format": "date",
          "title": "Collected At",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_name",
        "licence",
        "collected_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Redaction": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "checked_by": {
          "title": "Checked By",
          "type": "string"
        }
      },
      "required": [
        "version",
        "checked_by"
      ],
      "title": "Redaction",
      "type": "object"
    },
    "Sender": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "dlt_header",
            "phone",
            "email",
            "unknown"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "type"
      ],
      "title": "Sender",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "type"
      ],
      "title": "Span",
      "type": "object"
    },
    "Synthetic": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "handwritten",
            "template",
            "paraphrase",
            "translate"
          ],
          "title": "Method",
          "type": "string"
        },
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "seed_id": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2,4}-[0-9]{3,6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Id"
        }
      },
      "required": [
        "method",
        "generator"
      ],
      "title": "Synthetic",
      "type": "object"
    },
    "Url": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "registered_domain": {
          "title": "Registered Domain",
          "type": "string"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/UrlSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "raw",
        "registered_domain"
      ],
      "title": "Url",
      "type": "object"
    },
    "UrlSnapshot": {
      "additionalProperties": false,
      "description": "Lookups taken once at collection time so every evaluation run sees identical signals.",
      "properties": {
        "taken_at": {
          "title": "Taken At",
          "type": "string"
        },
        "rdap_created": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rdap Created"
        },
        "ct_first_seen": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ct First Seen"
        },
        "reputation_hit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reputation Hit"
        },
        "lookup_errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lookup Errors",
          "type": "array"
        }
      },
      "required": [
        "taken_at"
      ],
      "title": "UrlSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z]{2,4}-[0-9]{3,6}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "channel": {
      "enum": [
        "sms",
        "whatsapp",
        "telegram",
        "email",
        "other",
        "unknown"
      ],
      "title": "Channel",
      "type": "string"
    },
    "sender": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sender"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "language": {
      "enum": [
        "english",
        "hinglish"
      ],
      "title": "Language",
      "type": "string"
    },
    "script": {
      "enum": [
        "latin",
        "devanagari",
        "mixed"
      ],
      "title": "Script",
      "type": "string"
    },
    "urls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Url"
      },
      "title": "Urls",
      "type": "array"
    },
    "scammer_ids": {
      "default": [],
      "items": {
        "pattern": "^(PHONE|UPI|EMAIL|ACCT)_[0-9a-f]{8,}$",
        "type": "string"
      },
      "title": "Scammer Ids",
      "type": "array"
    },
    "gold": {
      "anyOf": [
        {
          "$ref": "#/$defs/Gold"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Annotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "synthetic": {
      "anyOf": [
        {
          "$ref": "#/$defs/Synthetic"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "adversarial": {
      "anyOf": [
        {
          "$ref": "#/$defs/Adversarial"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "campaign_id": {
      "anyOf": [
        {
          "pattern": "^g-[0-9a-f]{10}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Campaign Id"
    },
    "redaction": {
      "$ref": "#/$defs/Redaction"
    }
  },
  "required": [
    "id",
    "text",
    "channel",
    "language",
    "script",
    "provenance",
    "redaction"
  ],
  "title": "Item",
  "type": "object"
}
